# Vorlage fuer /opt/fabu/.env.production auf dem Hetzner-Server.
#
# Die echte Datei liegt ausschliesslich dort, mit chmod 600 und Eigentuemer
# frank, und ist per .gitignore vom Repo ausgeschlossen. Gesichert wird sie
# GPG-verschluesselt durch infra/scripts/backup.sh — ein Datenbank-Dump ohne
# JWT_SECRET und DB-Passwort laesst sich nicht wiederherstellen.
#
# Nach jeder Aenderung:
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d

# ─── Datenbank ───────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD wird vom postgres-Container gelesen, DATABASE_URL vom
# Backend. Beide muessen dasselbe Passwort enthalten. Der Host ist der
# Compose-Servicename, nicht localhost — api und postgres sind getrennte
# Container im Netz "internal".
#
#   openssl rand -hex 32
POSTGRES_PASSWORD=
DB_CLIENT=postgres
DATABASE_URL=postgresql://fabu:<POSTGRES_PASSWORD>@postgres:5432/fabu

# ─── Anwendung ───────────────────────────────────────────────────────────────
# JWT_SECRET beim Umzug UNVERAENDERT vom alten Server uebernehmen. Ein neues
# Secret macht jedes aktive Login und jeden offenen Passwort-Reset-Link
# sofort ungueltig. Ohne JWT_SECRET startet das Backend nicht (Absicht).
#
# Nur fuer eine Neuinstallation von Null:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

NODE_ENV=production
APP_FRONTEND_URL=https://app.fabu-online.de

# ─── Mailversand (Resend) ────────────────────────────────────────────────────
# MAIL_FROM muss eine in Resend verifizierte Domain benutzen. Verifiziert ist
# mail.fabu-online.de ueber drei DNS-Records:
#   resend._domainkey.mail   TXT  p=...                         (DKIM)
#   send.mail                TXT  v=spf1 include:amazonses.com ~all
#   send.mail                MX   10 feedback-smtp.eu-west-1.amazonses.com
# Diese Records muessen in der aktiven DNS-Zone stehen, sonst scheitern
# Passwort-Reset-, Einladungs- und Erinnerungsmails stillschweigend.
RESEND_API_KEY=
# Bare Adresse, kein "Name <adresse>" — so steht es heute auf dem VPS und
# so gibt backend/src/mail/mailer.js es unveraendert an Resend weiter.
MAIL_FROM=noreply@mail.fabu-online.de
